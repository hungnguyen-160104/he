# ExamHub THPT — biến môi trường mẫu. CHỈ CHỨA PLACEHOLDER.
# Sao chép thành .env.local (đã được .gitignore) rồi điền giá trị thật. Không commit secret.

# ── MongoDB Atlas (bắt buộc để chạy chức năng có dữ liệu) ──────────────────────
# Lấy tại Atlas → Database → Connect → Drivers. Thay <user>, <password>, <cluster>.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=examhub
# Kích thước pool mỗi instance serverless (Atlas Free giới hạn số kết nối). Mặc định 10.
MONGODB_MAX_POOL_SIZE=10
# Tự tạo index khi khởi động (true mặc định). Có thể đặt false ở production và chạy `pnpm db:indexes`.
MONGODB_AUTO_INDEX=true

# ── Auth (NextAuth v4 / Auth.js stable) ─────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<random-32+-chars>
# URL gốc của ứng dụng (bắt buộc khi deploy ngoài Vercel; Vercel tự nhận diện).
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudinary (không bắt buộc; thiếu thì upload ảnh báo "Chưa cấu hình Cloudinary") ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc trên Cloudinary do server chỉ định (a-z, 0-9, _ -).
CLOUDINARY_UPLOAD_FOLDER=examhub

# ── Email (không bắt buộc) ─────────────────────────────────────────────────────
# none    : không gửi email (mặc định). Quên mật khẩu/xác minh email bị tắt và hiển thị thông báo.
# console : CHỈ development — in liên kết ra log server thay vì gửi email thật.
# resend  : gửi qua Resend HTTP API (cần RESEND_API_KEY + MAIL_FROM với domain đã xác minh).
MAIL_PROVIDER=none
MAIL_FROM=
RESEND_API_KEY=
# Bắt buộc xác minh email trước khi đăng nhập. Mặc định: true ở production, false ở development.
REQUIRE_EMAIL_VERIFICATION=false

# ── Chế độ thử nghiệm (CHỈ local) ──────────────────────────────────────────────
# true: đề thi thử không đếm giờ, không giới hạn số bài làm dở, tắt rate limit.
# Luôn bị bỏ qua ở production (pnpm build/start, Vercel) — giới hạn vẫn bật.
UNLIMITED_MODE=false
